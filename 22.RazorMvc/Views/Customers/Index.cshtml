@model List<CustomerRow>
@{
    ViewData["Title"] = "Customers";
}
<h1 class="h3 mb-3">Customers</h1>
<p class="text-muted">The fluent grid builder, the twin of &lt;sgc-grid&gt;. BindTo hands it the whole
list: every row is rendered and the headers sort in the browser, with no data endpoint.</p>

@(Html.Sgc().Grid<CustomerRow>("customers")
    .Key(c => c.Id)
    .Columns(c =>
    {
        c.Bound(x => x.Id).Title("#").Width(70);
        c.Bound(x => x.Name);
        c.Bound(x => x.City);
        c.Bound(x => x.Country);
        c.Bound(x => x.Orders).Align("right");
        c.Bound(x => x.Revenue).Format("{0:N2}").Align("right");
    })
    .BindTo(Model))
