<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - sgcHTML Razor MVC</title>
    @* Bootstrap plus the /sgcHTML.css bundle of every sgc component. *@
    <sgc-styles />
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Orders" asp-action="Index">sgcHTML Razor MVC</a>
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" asp-controller="Orders" asp-action="Index">Orders</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Orders" asp-action="Create">New order</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Customers" asp-action="Index">Customers</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
            </ul>
        </div>
    </nav>
    <main class="container">
        @RenderBody()
    </main>
    @* htmx, Bootstrap JS and the sgcHTMX runtime; live="ws" also opens the
       WebSocket that live charts listen to. *@
    <sgc-scripts live="ws" />
</body>
</html>
