<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    sgcSaaS - multi-tenant SaaS control plane demo on ASP.NET Core
    (mirror of demos\60.HTML\16.SaaS).

    The 60.HTML version hosts a TsgcWebSocketHTTPServer and renders every page in
    DispatchRequest. This mirror keeps the SAME reusable logic (sgcSaaS_Bcrypt.cs,
    sgcSaaS_Config.cs, sgcSaaS_DB.cs, sgcSaaS_Pages.cs, sgcSaaS_Passkeys.cs,
    sgcSaaS_Sessions.cs and sgcSaaS_Types.cs are copied VERBATIM) but hosts it on
    Kestrel: the ASP.NET Core adapter serves the built-in client assets
    (Bootstrap / Chart.js / htmx, all by file name) and the htmx WebSocket
    channel, and this app owns every page route via Minimal API endpoints. Auth
    (bcrypt + WebAuthn passkeys), the in-memory cookie session store, the
    multi-tenant SQLite CRUD and the node-layer view are all the reused plain-C#
    files; only the hosting layer (Program.cs + sgcSaaSWebHost.cs) is new.

    The two host files that were NOT copied are sgcSaaS_Server.cs (the
    TsgcWebSocketHTTPServer host) and the console Program.cs.

    Nullable + ImplicitUsings are disabled: the reused files carry no nullable
    reference annotations (they predate them), matching the 60.HTML build.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SaaS</RootNamespace>
    <AssemblyName>sgcSaaSWeb</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\sgcHTML.AspNetCore\esegece.sgcHTML.AspNetCore.csproj" Condition="'$(SgcHTMLAspNetCoreUseProject)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same SQLite provider + version the 60.HTML console demo used. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Update="sgcSaaSServer.conf.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
