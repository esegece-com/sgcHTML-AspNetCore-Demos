<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The demos restore every package from nuget.org only. Inherited sources are
    cleared so a stale local feed in a machine level NuGet config can never
    break the restore.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
