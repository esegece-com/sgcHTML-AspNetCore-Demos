<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    POS web-app demo on ASP.NET Core (mirror of demos\60.HTML\14.POS).

    The 60.HTML version hosts a TsgcWebSocketHTTPServer and renders every page in
    DispatchRequest. This mirror keeps the SAME reusable logic (sgcPOS_Bcrypt.cs,
    sgcPOS_Config.cs, sgcPOS_DB.cs, sgcPOS_Pages.cs, sgcPOS_Passkeys.cs,
    sgcPOS_Sessions.cs and sgcPOS_Types.cs are copied VERBATIM) but hosts it on
    Kestrel: the ASP.NET Core adapter serves the built-in client assets
    (Bootstrap / Chart.js / htmx, all by file name) and the htmx WebSocket
    channel, and this app owns every page route via Minimal API endpoints. Auth
    (bcrypt + WebAuthn passkeys), the in-memory cookie session store and the
    SQLite CRUD are all the reused plain-C# files; only the hosting layer
    (Program.cs + sgcPOSWebHost.cs) is new.

    This mirrors the host pattern established by the 01.ERP port.

    The two host files that were NOT copied are sgcPOS_Server.cs (the
    TsgcWebSocketHTTPServer host) and the console Program.cs.

    Nullable + ImplicitUsings are disabled: the reused files carry no nullable
    reference annotations (they predate them), matching the 60.HTML build.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>POS</RootNamespace>
    <AssemblyName>sgcPOSWeb</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\sgcHTML.AspNetCore\esegece.sgcHTML.AspNetCore.csproj" Condition="'$(SgcHTMLAspNetCoreUseProject)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same SQLite provider + version the 60.HTML console demo used. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Update="sgcPOSServer.conf.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
