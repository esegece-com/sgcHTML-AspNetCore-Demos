<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    ShopAssistant (TechNest) AI storefront demo on ASP.NET Core (mirror of
    demos\60.HTML\10.ShopAssistant).

    The 60.HTML version hosts TsgcWebSocketHTTPServer and renders pages in
    DispatchRequest. This mirror keeps the SAME reusable logic (sgcShop_Catalog.cs,
    sgcShop_AI.cs, sgcShop_Pages.cs, sgcShop_Types.cs and sgcShop_Config.cs are
    copied VERBATIM) but hosts it on Kestrel: the ASP.NET Core adapter serves the
    built-in client assets, and this app owns every route via Minimal API
    endpoints. The in-memory cookie session store (TShopSessionStore) is a plain
    C# singleton; the "shop_session" cookie is read/written through the ASP.NET
    Core cookie API. AI stays keyless by default (provider "none" => local
    grounded fallback), so it builds and runs with no external dependency.

    Nullable is disabled: the reused files carry no nullable reference
    annotations (they predate them), matching the 60.HTML build.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Shop</RootNamespace>
    <AssemblyName>sgcShopWeb</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\sgcHTML.AspNetCore\esegece.sgcHTML.AspNetCore.csproj" Condition="'$(SgcHTMLAspNetCoreUseProject)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <None Update="sgcShopServer.conf.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
