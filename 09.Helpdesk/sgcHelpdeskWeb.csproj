<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Helpdesk support-ticket demo on ASP.NET Core (mirror of
    demos\60.HTML\09.Helpdesk).

    The 60.HTML version hosts a TsgcWebSocketHTTPServer and renders every page in
    DispatchRequest. This mirror keeps the SAME reusable logic (sgcHelpdesk_Bcrypt.cs,
    sgcHelpdesk_Config.cs, sgcHelpdesk_DB.cs, sgcHelpdesk_Pages.cs,
    sgcHelpdesk_Sessions.cs and sgcHelpdesk_Types.cs are copied VERBATIM) but hosts
    it on Kestrel: the ASP.NET Core adapter serves the built-in client assets
    (Bootstrap, by file name) and the htmx WebSocket channel, and this app owns
    every page route via Minimal API endpoints. Auth (bcrypt), the in-memory cookie
    session store and the SQLite ticket store are all the reused plain-C# files;
    only the hosting layer (Program.cs + HelpdeskWebHost.cs) is new.

    MULTIPART: the 60.HTML sgcHelpdesk_Multipart.cs hand-rolled multipart parser is
    NOT copied - ASP.NET Core's IFormFile replaces it. Only that unit's STORAGE half
    (THelpdeskAttachStore) lives on, ported into sgcHelpdesk_Attachments.cs and fed
    from IFormFile.

    The three host files NOT copied are sgcHelpdesk_Server.cs (the
    TsgcWebSocketHTTPServer host), the console Program.cs and sgcHelpdesk_Multipart.cs.

    Nullable + ImplicitUsings are disabled: the reused files carry no nullable
    reference annotations (they predate them), matching the 60.HTML build.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Helpdesk</RootNamespace>
    <AssemblyName>sgcHelpdeskWeb</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\sgcHTML.AspNetCore\esegece.sgcHTML.AspNetCore.csproj" Condition="'$(SgcHTMLAspNetCoreUseProject)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same SQLite provider + version the 60.HTML console demo used. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Update="sgcHelpdeskServer.conf.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
