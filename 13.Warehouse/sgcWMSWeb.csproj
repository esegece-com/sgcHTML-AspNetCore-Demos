<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    sgcWMS warehouse-management demo on ASP.NET Core
    (mirror of demos\60.HTML\13.Warehouse).

    The 60.HTML version hosts a TsgcWebSocketHTTPServer and renders every page in
    DispatchRequest. This mirror keeps the SAME reusable logic (sgcWMS_Bcrypt.cs,
    sgcWMS_Config.cs, sgcWMS_DB.cs, sgcWMS_Handheld.cs, sgcWMS_Multipart.cs,
    sgcWMS_Pages.cs, sgcWMS_Passkeys.cs, sgcWMS_Reports.cs, sgcWMS_Sessions.cs and
    sgcWMS_Types.cs are copied VERBATIM) but hosts it on Kestrel: the ASP.NET Core
    adapter serves the built-in client assets (Bootstrap / Chart.js / htmx, all by
    file name) and the htmx WebSocket channel, and this app owns every page route
    via Minimal API endpoints. Auth (bcrypt + WebAuthn passkeys), the in-memory
    cookie session store and the SQLite data layer are all reused files; only the
    hosting layer (Program.cs + sgcWMSWebHost.cs) is new.

    This mirrors the host pattern established by the 01.ERP / 02.AdminCRUD ports.

    The two host files that were NOT copied are sgcWMS_Server.cs (the
    TsgcWebSocketHTTPServer host) and the console Program.cs.

    Nullable + ImplicitUsings are disabled: the reused files carry no nullable
    reference annotations, matching the 60.HTML build.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>WMS</RootNamespace>
    <AssemblyName>sgcWMSWeb</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\sgcHTML.AspNetCore\esegece.sgcHTML.AspNetCore.csproj" Condition="'$(SgcHTMLAspNetCoreUseProject)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same SQLite provider + version the 60.HTML console demo used. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Update="sgcWMSServer.conf.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
