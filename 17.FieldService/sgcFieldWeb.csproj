<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    sgcField - field service management demo on ASP.NET Core
    (mirror of demos\60.HTML\17.FieldService).

    The 60.HTML version hosts a TsgcWebSocketHTTPServer and renders every page in
    DispatchRequest. This mirror keeps the SAME reusable logic (sgcField_Bcrypt.cs,
    sgcField_Config.cs, sgcField_DB.cs, sgcField_Multipart.cs, sgcField_Pages.cs,
    sgcField_Passkeys.cs, sgcField_Sessions.cs and sgcField_Types.cs are copied
    VERBATIM) but hosts it on Kestrel: the ASP.NET Core adapter serves the built-in
    client assets (Bootstrap / Chart.js / htmx, all by file name) and the htmx
    WebSocket channel, and this app owns every page route via Minimal API
    endpoints. Auth (bcrypt + WebAuthn passkeys), the in-memory cookie session
    store, the SQLite data layer, the photo store and the component view layer are
    all the reused plain-C# files; only the hosting layer (Program.cs +
    sgcFieldWebHost.cs) is new.

    This mirrors the host pattern established by the 01.ERP / 13.Warehouse /
    15.Reports / 16.SaaS ports. The world simulator that pushes hx-swap-oob
    fragments is a BackgroundService here (15.Reports pattern) instead of the
    60.HTML push thread, and it broadcasts through the adapter's ISgcHtmlHub.

    The two host files that were NOT copied are sgcField_Server.cs (the
    TsgcWebSocketHTTPServer host) and the console Program.cs.

    Nullable + ImplicitUsings are disabled: the reused files carry no nullable
    reference annotations, matching the 60.HTML build.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FieldService</RootNamespace>
    <AssemblyName>sgcFieldWeb</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\sgcHTML.AspNetCore\esegece.sgcHTML.AspNetCore.csproj" Condition="'$(SgcHTMLAspNetCoreUseProject)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same SQLite provider + version the 60.HTML console demo used. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Update="sgcFieldServer.conf.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
