<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    sgcReports - reporting and BI portal web-app demo on ASP.NET Core
    (mirror of demos/60.HTML/15.Reports).

    The 60.HTML version hosts a TsgcWebSocketHTTPServer and renders every page in
    DispatchRequest. This mirror keeps the SAME reusable logic
    (sgcReports_Analytics.cs, sgcReports_Bcrypt.cs, sgcReports_Config.cs,
    sgcReports_DB.cs, sgcReports_I18n.cs, sgcReports_Pages.cs, sgcReports_Passkeys.cs,
    sgcReports_Sessions.cs and sgcReports_Types.cs are copied VERBATIM) but hosts
    it on Kestrel: the ASP.NET Core adapter serves the built-in client assets
    (Bootstrap / Chart.js / htmx, all by file name) and the htmx WebSocket
    channel, and this app owns every page route via Minimal API endpoints. Auth
    (bcrypt + WebAuthn passkeys), the in-memory cookie session store, i18n and the
    SQLite report engine are all the reused plain-C# files; only the hosting layer
    (Program.cs + sgcReportsWebHost.cs) is new.

    This mirrors the host pattern established by the 01.ERP port.

    The two host files that were NOT copied are sgcReports_Server.cs (the
    TsgcWebSocketHTTPServer host) and the console Program.cs.

    Nullable + ImplicitUsings are disabled: the reused files carry no nullable
    reference annotations, matching the 60.HTML build.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Reports</RootNamespace>
    <AssemblyName>sgcReportsWeb</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\sgcHTML.AspNetCore\esegece.sgcHTML.AspNetCore.csproj" Condition="'$(SgcHTMLAspNetCoreUseProject)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same SQLite provider + version the 60.HTML console demo used. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Update="sgcReportsServer.conf.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
